{
  "anthropic_key": "sk-ant-xxxxx",
  "telegram_token": "123456:ABC-DEF",
  "model": "claude-sonnet-4-6",
  "default_project_dir": "/path/to/your/project",
  "allowed_user_ids": [123456789],

  "multimedia": {
    "enable_photo_support": true,
    "enable_voice_support": true,
    "openai_api_key": "sk-xxxxx",
    "max_file_size_mb": 20,
    "temp_download_dir": "./temp/media",
    "voice_to_text_provider": "openai_whisper"
  },

  "enable_web_interface": true,
  "web_port": "8080",
  "web_static_dir": "./web",

  "codex_interception": {
    "enabled": false,
    "sessions_dir": ""
  },

  "enable_decision_logging": true,
  "decision_log_level": "detailed",

  "enable_multi_agent": false,

  "model_routing": {
    "enable_dynamic_routing": false,
    "fast_model": "claude-haiku-4-5-20251001",
    "smart_model": "claude-sonnet-4-6",
    "deep_model": "claude-opus-4-7",
    "codex_fast_model": "gpt-5.4-mini",
    "codex_smart_model": "gpt-5.4",
    "codex_deep_model": "gpt-5.5",
    "use_gpt4o_mini_for_triage": false
  },

  "model_pricing": {
    "haiku": {
      "input": 1.00,
      "output": 5.00
    },
    "sonnet": {
      "input": 3.00,
      "output": 15.00
    },
    "opus": {
      "input": 15.00,
      "output": 75.00
    }
  },

  "ai_backend": "claude",
  "cli_timeout_minutes": 15,

  "enable_performance_monitoring": true,
  "performance_metrics_retention": 24,

  "enable_persistence": true,
  "database_path": "./data/alice.db",
  "data_retention_days": 30,
  "enable_data_cleanup": true,

  "hermes": {
    "enabled": false,
    "strict_mode_enabled": false,
    "auto_route_complex": false,
    "budget": {
      "max_total_tokens": 500000,
      "max_wallclock_seconds": 3600
    },
    "preflight": {
      "enabled": false,
      "model": "claude-haiku-4-5-20251001",
      "completion_threshold": 90,
      "timeout_seconds": 20
    },
    "summary": {
      "enabled": false,
      "verbosity": "minimal",
      "include_cost_estimate": false,
      "targets": [
        "telegram"
      ]
    }
  },

  "security": {
    "enable_rate_limiting": true,
    "rate_limit_rpm": 60,
    "rate_limit_burst": 10,
    "enable_pii_detection": true,
    "enable_audit_logging": true,
    "data_retention_days": 30,
    "require_authentication": false,
    "session_timeout_minutes": 60,
    "max_concurrent_sessions": 100
  }
}
