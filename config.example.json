{
  "anthropic_key": "sk-ant-xxxxx",
  "telegram_token": "123456:ABC-DEF",
  "model": "claude-sonnet-4-6",
  "default_project_dir": "/path/to/your/project",
  "allowed_user_ids": [123456789],

  "multimedia": {
    "enable_photo_support": true,
    "enable_voice_support": true,
    "enable_image_generation": false,
    "openai_api_key": "sk-xxxxx",
    "max_file_size_mb": 20,
    "temp_download_dir": "./temp/media",
    "voice_to_text_provider": "openai_whisper",
    "image_model": "gpt-image-2",
    "image_size": "1024x1024",
    "image_quality": "auto"
  },

  "enable_web_interface": true,
  "web_port": "8080",
  "web_static_dir": "./web",

  "codex_interception": {
    "enabled": false,
    "sessions_dir": ""
  },

  "enable_decision_logging": true,
  "decision_log_level": "detailed",


  "model_routing": {
    "enable_dynamic_routing": false,
    "fast_model": "claude-haiku-5-5",
    "smart_model": "claude-sonnet-5-5",
    "deep_model": "claude-opus-5-5",
    "flagship_model": "claude-fable-5-2",
    "codex_fast_model": "gpt-5.4-mini",
    "codex_smart_model": "gpt-5.4",
    "codex_deep_model": "gpt-5.5",
    "use_gpt4o_mini_for_triage": false,
    "fast_mode_enabled": false
  },

  "model_pricing": {
    "haiku": {
      "input": 1.00,
      "output": 5.00
    },
    "sonnet": {
      "input": 3.00,
      "output": 15.00
    },
    "opus": {
      "input": 5.00,
      "output": 25.00
    },
    "fable_5_2": {
      "input": 8.0,
      "output": 40.0
    },
    "opus_fast": {
      "input": 10.00,
      "output": 50.00
    }
  },

  "ai_backend": "claude",
  "cli_timeout_minutes": 15,

  "enable_performance_monitoring": true,
  "performance_metrics_retention": 24,

  "enable_persistence": true,
  "database_path": "./data/alice.db",
  "data_retention_days": 30,
  "enable_data_cleanup": true,

  "hermes": {
    "planner_effort": "medium"
  },

  "fleet": {
    "scout_backend": "claude",
    "scout_codex_model": "",
    "scout_quota": {
      "max_transfers": 0,
      "window_minutes": 0,
      "claude_tokens": 0,
      "codex_tokens": 0,
      "claude_error_patterns": [],
      "codex_error_patterns": [],
      "reset_layout": "2006-01-02T15:04:05Z07:00",
      "reset_timezone": "UTC"
    },
    "worktree_root": "./data/worktrees",
    "report_root": "./data/fleet-reports",
    "max_concurrent": 2,
    "default_trust_mode": "local-only",
    "daily_budget_usd": 0,
    "task_budget_usd": 0,
    "verify_step_timeout_minutes": 20,
    "dashboard_url": "",
    "startup_resume_limit": 2,
    "owner_user_id": 0,
    "auto_model": true,
    "milestone": {
      "dependency_markers": ["依賴", "相依", "Depends on", "Blocked by"],
      "blocked_labels": ["blocked"],
      "exclude_labels": ["duplicate", "invalid", "wontfix"],
      "reconcile_seconds": 120
    },
    "tier_labels": {
      "docs": "fast",
      "size:L": "deep",
      "size:XL": "flagship"
    },
    "scout_codex_tiers": []
  },

  "security": {
    "enable_rate_limiting": true,
    "rate_limit_rpm": 60,
    "rate_limit_burst": 10,
    "enable_pii_detection": true,
    "enable_audit_logging": true,
    "data_retention_days": 30,
    "require_authentication": false,
    "session_timeout_minutes": 60,
    "max_concurrent_sessions": 100
  }
}
